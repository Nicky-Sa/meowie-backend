{
  "Template": {
    "TemplateName": "OtpEmailTemplate",
    "SubjectPart": "Your Meowie Verification Code",
    "TextPart": "Meowie verification code: {{otp}}",
    "HtmlPart": "<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Verification Code</title>\n  <style>\n      body {\n          background-color: #f6f9fc;\n          font-family: \"Segoe UI\", Arial, sans-serif;\n          margin: 0;\n          padding: 0;\n          color: #333;\n      }\n      .container {\n          max-width: 480px;\n          margin: 40px auto;\n          background: #ffffff;\n          border-radius: 12px;\n          box-shadow: 0 4px 10px rgba(0, 0, 0, 0.06);\n          overflow: hidden;\n      }\n      .header {\n          background: #595bef;\n          color: #ffffff;\n          text-align: center;\n          padding: 24px 20px;\n      }\n      .header h1 {\n          font-size: 22px;\n          margin: 0;\n      }\n      .content {\n          padding: 30px 25px;\n          text-align: center;\n      }\n      .content p {\n          font-size: 15px;\n          color: #555;\n          line-height: 1.6;\n      }\n      .otp-box {\n          display: inline-block;\n          background: #f0f4ff;\n          border: 1px solid #c7d2fe;\n          border-radius: 8px;\n          font-size: 28px;\n          font-weight: bold;\n          letter-spacing: 8px;\n          padding: 14px 28px;\n          margin: 18px 0;\n          color: #595bef;\n      }\n      .footer {\n          text-align: center;\n          font-size: 12px;\n          color: #888;\n          padding: 20px;\n          border-top: 1px solid #eee;\n      }\n      .footer a {\n          color: #595bef;\n          text-decoration: none;\n      }\n      @media (max-width: 600px) {\n          .container {\n              margin: 20px;\n          }\n      }\n  </style>\n</head>\n<body>\n<div class=\"container\">\n  <div class=\"header\">\n    <h1>Email Verification</h1>\n  </div>\n  <div class=\"content\">\n    <p>Hello,</p>\n    <p>Use the code below to verify your email address. This code will expire in <b>5 minutes</b>.</p>\n    <div class=\"otp-box\">{{otp}}</div>\n    <p>If you didn’t request this code, you can safely ignore this email.</p>\n  </div>\n  <div class=\"footer\">\n    <p>© {{year}} Meowie. All rights reserved.</p>\n    <p><a href=\"https://meowie.app\">Visit Meowie</a></p>\n  </div>\n</div>\n</body>\n</html>\n"
  }
}
